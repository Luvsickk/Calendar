<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/mainbg"
    android:padding="8dp">

    <TextView
        android:id="@+id/syllabusTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/header_bg"
        android:layout_marginTop="255dp"
        android:elevation="4dp"
        android:gravity="center"
        android:padding="16dp"
        android:text="Syllabus"
        android:textColor="#333333"
        android:textSize="22sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/term1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/syllabusTitle"
        android:elevation="4dp"
        android:padding="6dp">

        <Button
            android:id="@+id/btnPrelims"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Prelims"
            android:layout_margin="8dp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/term2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/term1"
        android:elevation="4dp"
        android:padding="6dp">

        <Button
            android:id="@+id/btnMidterm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Midterm"
            android:layout_margin="8dp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/term3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/term2"
        android:elevation="4dp"
        android:padding="6dp">

        <Button
            android:id="@+id/btnEndterm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Endterm"
            android:layout_margin="8dp"/>
    </LinearLayout>

</RelativeLayout>